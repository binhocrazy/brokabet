<style>
:root{--bg:#0b0e12;--panel:#12171e;--panel2:#171d26;--line:#232b36;--txt:#e7edf3;--mut:#8b97a6;--acc:#12c2c2;--green:#1fbf75;--red:#e04b4b;--void:#c9a227;--pending:#5b6675}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font:14px/1.5 system-ui,Segoe UI,Roboto,sans-serif}
a{color:inherit;text-decoration:none}
.wrap{display:flex;min-height:100vh}
.side{width:210px;background:#0e1218;border-right:1px solid var(--line);padding:18px 12px;position:sticky;top:0;height:100vh}
.brand{font-weight:800;font-size:18px;letter-spacing:.5px;padding:6px 10px 18px;color:var(--acc)}
.nav a{display:block;padding:10px 12px;border-radius:9px;color:var(--mut);margin-bottom:3px}
.nav a.active,.nav a:hover{background:var(--panel2);color:var(--txt)}
.main{flex:1;min-width:0}
.top{display:flex;justify-content:space-between;align-items:center;padding:14px 26px;border-bottom:1px solid var(--line);background:#0e1218;position:sticky;top:0;z-index:5}
.top .r{display:flex;gap:14px;align-items:center;color:var(--mut)}
.content{padding:26px;max-width:1200px}
.grid{display:grid;gap:16px}
.cards{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.kpis{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}
.card .lbl{color:var(--mut);font-size:12px;display:flex;gap:7px;align-items:center}
.card .val{font-size:24px;font-weight:700;margin-top:8px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:18px}
.panel h2{margin:0 0 14px;font-size:16px}
h1{font-size:20px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 20px}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);font-size:13px}
th{color:var(--mut);font-weight:600}
.tag{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700}
.tag.green{background:rgba(31,191,117,.15);color:var(--green)}.tag.red{background:rgba(224,75,75,.15);color:var(--red)}
.tag.void{background:rgba(201,162,39,.15);color:var(--void)}.tag.pending{background:rgba(91,102,117,.2);color:var(--mut)}
.tag.hgreen{background:rgba(31,191,117,.12);color:var(--green)}.tag.hred{background:rgba(224,75,75,.12);color:var(--red)}
.tag.shadow{background:rgba(18,194,194,.14);color:var(--acc)}.tag.placed{background:rgba(31,191,117,.15);color:var(--green)}
.tag.failed{background:rgba(224,75,75,.15);color:var(--red)}.tag.rejected{background:rgba(201,162,39,.15);color:var(--void)}
.btn{display:inline-block;background:var(--acc);color:#04191b;border:0;padding:9px 16px;border-radius:9px;font-weight:700;cursor:pointer;font-size:13px}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--txt)}
.btn.sm{padding:5px 10px;font-size:12px}
.btn.danger{background:transparent;border:1px solid var(--red);color:var(--red)}
input,select{background:var(--panel2);border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:9px 11px;font:inherit;width:100%}
label{display:block;font-size:12px;color:var(--mut);margin:0 0 5px}
.row{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.mut{color:var(--mut)}.mono{font-family:ui-monospace,Consolas,monospace}
.center{min-height:100vh;display:flex;align-items:center;justify-content:center}
.loginbox{width:360px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px}
.err{background:rgba(224,75,75,.12);color:var(--red);padding:10px 12px;border-radius:9px;margin-bottom:14px;font-size:13px}
.pill{font-size:11px;padding:2px 8px;border-radius:20px;background:var(--panel2);color:var(--mut);border:1px solid var(--line)}
</style>
