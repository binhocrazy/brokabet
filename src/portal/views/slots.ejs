<%- include('_shell_open') %>
<h1>Meus Slots</h1><p class="sub">Contas conectadas e como cada uma executa as apostas.</p>

<div class="panel">
  <h2>Novo slot</h2>
  <form method="post" action="/slots">
    <div class="row">
      <div><label>Nome</label><input name="name" placeholder="Conta 1" required></div>
      <div><label>Casa</label><select name="bookie"><option>B365</option><option>SUPERBET</option><option>BETANO</option></select></div>
      <div><label>Executor</label><select name="executor">
        <option value="shadow">Sombra (só simula)</option>
        <option value="jbot">JBot (Felipe)</option>
        <option value="bet365">Bet365 direto (em breve)</option>
      </select></div>
      <div><label>Stake padrão (R$)</label><input name="stake" type="number" step="0.01" value="0"></div>
    </div>
    <div class="row" style="margin-top:12px">
      <div><label>Usuário da casa</label><input name="bet_user" placeholder="opcional agora"></div>
      <div><label>Senha da casa</label><input name="bet_pass" type="password" placeholder="opcional agora"></div>
      <div><label>JBot client_key (se executor = JBot)</label><input name="jbot_key" class="mono" placeholder="UUID"></div>
      <div style="display:flex;align-items:flex-end"><button class="btn" style="width:100%">Adicionar slot</button></div>
    </div>
  </form>
</div>

<div class="panel">
  <h2>Slots (<%= slots.length %>)</h2>
  <% if (!slots.length) { %><p class="mut">Nenhum slot. Crie o primeiro acima.</p><% } else { %>
  <table><thead><tr><th>Nome</th><th>Casa</th><th>Executor</th><th>Stake</th><th>Saldo</th><th>Status</th><th></th></tr></thead><tbody>
  <% for (const s of slots) { %>
    <tr>
      <td><%= s.name %></td>
      <td><span class="pill"><%= s.bookie %></span></td>
      <td><span class="tag <%= s.executor==='bet365'?'placed':s.executor==='jbot'?'shadow':'pending' %>"><%= s.executor %></span></td>
      <td>R$ <%= Number(s.stake).toFixed(2) %></td>
      <td><%= s.balance!=null?('R$ '+Number(s.balance).toFixed(2)):'—' %></td>
      <td><%= s.paused ? '<span class="tag void">pausado</span>' : '<span class="tag green">ativo</span>' %></td>
      <td style="white-space:nowrap">
        <form method="post" action="/slots/<%= s.id %>/toggle" style="display:inline"><button class="btn ghost sm"><%= s.paused?'Ativar':'Pausar' %></button></form>
        <form method="post" action="/slots/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Remover slot?')"><button class="btn danger sm">Remover</button></form>
      </td>
    </tr>
  <% } %>
  </tbody></table><% } %>
</div>
<%- include('_shell_close') %>
