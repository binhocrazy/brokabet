# Banco (Postgres 16 local)
DATABASE_URL=postgres://brokabet:TROQUE@127.0.0.1:5432/brokabet
# Portal + API
BROKABET_PORT=8367
SESSION_SECRET=troque-por-uma-string-aleatoria
# Usuário inicial (criado no 1º boot se não houver nenhum)
BOOTSTRAP_EMAIL=operacao@brokalab.com
BOOTSTRAP_PASS=brokabet
# Leitor Bet365 (o mesmo feed que o Brokalab usa)
BET365_READ_BASE=http://127.0.0.1:8365
# Executor Bet365 direto: só liga quando o gerador X-Net-Sync-Term existir
BET365_NETSYNC_READY=0
# JBot (pros slots com executor=jbot)
JBOT_API_BASE=https://apijbot.jbot.com.br
